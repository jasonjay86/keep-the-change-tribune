<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Keep The Change Hall of Fame — Est. 2019</title>
<meta name="description" content="{{ league_name }} Hall of Fame: {{ totals.seasons }} seasons, {{ totals.managers }} managers, {{ totals.games }} games. Every champion, every record, every rivalry since {{ totals.first_season }}.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Old+Standard+TT:ital,wght@0,400;0,700;1,400&family=UnifrakturMaguntia&display=swap" rel="stylesheet">
<link rel="stylesheet" href="static/style.css">
</head>
<body>
<div class="paper paper--hof">

<header class="masthead">
  <div class="edition-line">Vol. I · The Archives · {{ totals.first_season }}–{{ totals.last_season }}</div>
  <h1 class="title">The Hall of Fame</h1>
  <div class="subtitle">The {{ league_name }} League · {{ totals.seasons }} seasons · {{ totals.managers }} managers · {{ totals.games }} games</div>
  <div class="rule rule-double"></div>
  <nav class="hof-nav">
    <a href="index.html">&larr; The Tribune</a>
    <a href="#trophy-room">Trophy Room</a>
    <a href="#record-book">Record Book</a>
    <a href="#ledger">All-Time Ledger</a>
    <a href="#resume">Résumé Grid</a>
    <a href="#rivalry">Rivalry File</a>
    <a href="#deals">Ledger of Deals</a>
    <a href="#bench">Bench File</a>
    <a href="#trades">Trade Ledger</a>
  </nav>
  <div class="rule rule-double"></div>
</header>

<!-- ================================================== INDUCTEE WALL -->
<section class="hof-wall">
  <div class="kicker accent">── The Wall of Champions ──</div>
  <p class="hof-lede">
    {% set champs = managers | selectattr('titles') | list %}
    {{ champs|length }} of {{ totals.managers }} managers have had their name engraved. {{ titles_awarded }} title honours have been awarded across
    {{ totals.seasons }} seasons — one of them shared. Reigning champion: <strong>{{ reigning_champion or '—' }}</strong>.
  </p>
  <div class="hof-plaques">
    {% for c in champs %}
    <div class="plaque {% if c.titles|length > 1 %}plaque--multi{% endif %}">
      <div class="plaque-rings">
        {% for t in c.titles %}<span class="ring{% if t in c.co_titles %} ring--shared{% endif %}">{{ t }}{% if t in c.co_titles %}&#8225;{% endif %}</span>{% endfor %}
      </div>
      <div class="plaque-name">{{ c.name }}</div>
      {% if c.team and c.team != c.name %}<div class="plaque-team">{{ c.team }}</div>{% endif %}
      <div class="plaque-titles">{{ c.titles|length }} title{% if c.titles|length != 1 %}s{% endif %}</div>
      <div class="plaque-meta">{{ c.record }} · {{ "%.3f"|format(c.pct) }} · {{ c.seasons }} season{% if c.seasons != 1 %}s{% endif %}</div>
      {% if c.co_titles %}<div class="plaque-meta plaque-meta--dim">Split the {{ c.co_titles|join(', ') }} title</div>{% endif %}
      {% if c.runner_ups %}<div class="plaque-meta plaque-meta--dim">Runner-up {{ c.runner_ups|join(', ') }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
</section>

<div class="rule rule-single"></div>

<!-- ================================================== TROPHY ROOM -->
<section id="trophy-room">
  <div class="kicker">── Chapter I · The Trophy Room ──</div>
  <p class="section-blurb">Every season on record. Champion, runner-up, final score, and the man who owned the regular season — which, as ever, is not the same thing.</p>
  <table class="rankings-table hof-table">
    <thead>
      <tr>
        <th class="col-rank">Year</th>
        <th>Champion</th>
        <th class="col-record">Reg.</th>
        <th>Runner-Up</th>
        <th class="col-record">Reg.</th>
        <th class="col-pf">Final</th>
        <th>No. 1 Seed</th>
        <th class="col-record">Seed Rec.</th>
      </tr>
    </thead>
    <tbody>
      {% for s in seasons|reverse %}
      <tr class="{% if loop.first and s.in_progress %}rank-row--top{% endif %}">
        <td class="col-rank"><strong>{{ s.season }}</strong></td>
        {% if s.co_champions %}
          <td><strong>{{ s.champions|join(' &amp; ') }}</strong> <span class="co-tag">co-champions</span></td>
          <td class="col-record">{{ s.champion_record }}</td>
        {% elif s.champion %}
          <td><strong>{{ s.champion }}</strong>{% if s.champion_team and s.champion_team != s.champion %} <em class="dim">({{ s.champion_team }})</em>{% endif %}</td>
          <td class="col-record">{{ s.champion_record }}</td>
        {% else %}
          <td colspan="2" class="dim"><em>In progress — through Week {{ s.weeks_played }}, {{ s.teams }} teams</em></td>
        {% endif %}
        <td>{{ s.runner_up or '—' }}</td>
        <td class="col-record">{{ s.runner_up_record or '—' }}</td>
        <td class="col-pf">{{ s.final_score or '—' }}</td>
        <td>{{ s.top_seed or '—' }}</td>
        <td class="col-record">{{ s.top_seed_record or '—' }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% set shared = seasons | selectattr('co_champions') | list %}
  {% for s in shared %}
  <p class="hof-footnote hof-adjudication"><strong>&#8225; {{ s.season }} — co-champions.</strong> {{ s.co_note }}
    The posted partial scores ({{ s.final_score }}) are not treated as a result; the ledger records a shared title rather
    than a winner and a loser.</p>
  {% endfor %}
</section>

<div class="rule rule-single"></div>

<!-- ================================================== RECORD BOOK -->
<section id="record-book">
  <div class="kicker">── Chapter II · The Record Book ──</div>
  <p class="section-blurb">Regular-season records unless stated. Ties and stat corrections honoured as the platform recorded them.</p>
  <div class="numbers-grid hof-records">
    {% for r in records %}
    <div class="record-card">
      <div class="record-label">{{ r.label }}</div>
      <div class="record-value">{{ r.value }}</div>
      <div class="record-holder">{{ r.holder }}</div>
      <div class="record-detail">{{ r.detail }}</div>
    </div>
    {% endfor %}
  </div>
</section>

<div class="rule rule-single"></div>

<!-- ================================================== ALL-TIME LEDGER -->
<section id="ledger">
  <div class="kicker">── Chapter III · The All-Time Ledger ──</div>
  <p class="section-blurb">Career regular-season totals, {{ totals.first_season }}–{{ totals.last_season }}. Wins tiebreak by percentage; titles outrank everything.</p>
  <div class="hof-scroll">
    <table class="rankings-table hof-table hof-table--wide">
      <thead>
        <tr>
          <th class="col-rank">#</th>
          <th>Manager</th>
          <th class="col-record">Record</th>
          <th class="col-pf">Win%</th>
          <th class="col-pf">PF</th>
          <th class="col-pf">PA</th>
          <th class="col-pf">Diff</th>
          <th class="col-pf">PPG</th>
          <th class="col-pf">Titles</th>
          <th class="col-pf">Playoffs</th>
          <th class="col-pf">Best</th>
          <th class="col-pf">Worst</th>
          <th class="col-pf">High</th>
          <th class="col-pf">Low</th>
          <th class="col-pf">Streak</th>
          <th class="col-pf">Luck</th>
        </tr>
      </thead>
      <tbody>
        {% for m in managers %}
        <tr class="{% if loop.index == 1 %}rank-row--top{% endif %} {% if m.seasons == 1 %}dim-row{% endif %}">
          <td class="col-rank">{{ loop.index }}</td>
          <td>
            <strong>{{ m.name }}</strong>
            <span class="dim hof-seasons">· {{ m.seasons }}y</span>
          </td>
          <td class="col-record">{{ m.record }}</td>
          <td class="col-pf">{{ "%.3f"|format(m.pct) }}</td>
          <td class="col-pf">{{ "%.1f"|format(m.pf) }}</td>
          <td class="col-pf">{{ "%.1f"|format(m.pa) }}</td>
          <td class="col-pf">{{ "%+.1f"|format(m.diff) }}</td>
          <td class="col-pf">{{ "%.1f"|format(m.ppg) }}</td>
          <td class="col-pf">{% if m.titles %}<strong>{{ m.titles|length }}</strong>{% if m.co_titles %}<span class="dim">&#8225;</span>{% endif %}{% else %}—{% endif %}</td>
          <td class="col-pf">{{ m.playoff_apps }}</td>
          <td class="col-pf">{{ m.best_finish if m.best_finish else '—' }}</td>
          <td class="col-pf">{{ m.worst_finish if m.worst_finish else '—' }}</td>
          <td class="col-pf">{{ "%.1f"|format(m.best_score) }}</td>
          <td class="col-pf">{{ "%.1f"|format(m.worst_score) }}</td>
          <td class="col-pf">{{ m.streak_w }}W</td>
          <td class="col-pf">{{ "%+.2f"|format(m.luck) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="hof-footnote">&#8225; includes a shared championship (see the Trophy Room). Luck = actual wins minus all-play expected wins (what a team would have won playing every opponent, every week). Positive means the schedule smiled; negative means it did not.</p>
</section>

<div class="rule rule-single"></div>

<!-- ================================================== RESUME GRID -->
<section id="resume">
  <div class="kicker">── Chapter IV · The Résumé Grid ──</div>
  <p class="section-blurb">Every season a manager has played, one card at a time. Pick a name and read the career as a column
    rather than a line in a table.</p>

  <div class="h2h-picker">
    <label for="resume-select">Manager</label>
    <select id="resume-select">
      {% for m in managers %}<option value="{{ m.name }}">{{ m.name }}</option>{% endfor %}
    </select>
    <span class="h2h-hint">Regular season record, finish and fate</span>
  </div>

  <div id="resume-note" class="resume-note"></div>

  <div class="hof-scroll">
    <table class="rankings-table hof-table resume-table">
      <thead>
        <tr>
          <th class="col-rank">Season</th>
          <th class="col-record">Record</th>
          <th class="col-pf">PF</th>
          <th class="col-pf">Seed</th>
          <th class="col-pf">Finish</th>
          <th>Fate</th>
        </tr>
      </thead>
      <tbody id="resume-body">
        <tr><td colspan="6" class="dim">Select a manager above.</td></tr>
      </tbody>
      <tfoot id="resume-foot"></tfoot>
    </table>
  </div>

  <script type="application/json" id="resume-data">{{ resume|tojson }}</script>
  <script type="application/json" id="resume-blurbs">{{ resume_blurbs|tojson }}</script>
  <script>
  (function () {
    var data = JSON.parse(document.getElementById('resume-data').textContent);
    var blurbs = JSON.parse(document.getElementById('resume-blurbs').textContent || '{}');
    var sel = document.getElementById('resume-select');
    var body = document.getElementById('resume-body');
    var foot = document.getElementById('resume-foot');
    var note = document.getElementById('resume-note');

    function esc(t) {
      return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c];
      });
    }

    function render(name) {
      var rows = data[name] || [];
      note.textContent = blurbs[name] || '';
      note.style.display = blurbs[name] ? 'block' : 'none';
      if (!rows.length) {
        body.innerHTML = '<tr><td colspan="6" class="dim">No seasons on record.</td></tr>';
        foot.innerHTML = '';
        return;
      }
      var w = 0, l = 0, t = 0, pf = 0, titles = 0;
      body.innerHTML = rows.map(function (r) {
        w += r.w; l += r.l; t += r.t; pf += r.pf;
        var big = (r.result === 'Champion' || r.result === 'Co-champion');
        if (big) titles++;
        var cls = big ? 'resume-title' : (r.result === 'Runner-up' ? 'resume-second' : '');
        return '<tr>' +
          '<td class="col-rank"><strong>' + esc(r.season) + '</strong></td>' +
          '<td class="col-record">' + esc(r.record) + '</td>' +
          '<td class="col-pf">' + Number(r.pf).toFixed(1) + '</td>' +
          '<td class="col-pf">' + (r.seed || '—') + '</td>' +
          '<td class="col-pf">' + (r.finish || '—') + '</td>' +
          '<td class="' + cls + '">' + esc(r.result) + '</td>' +
        '</tr>';
      }).join('');
      var g = w + l + t;
      foot.innerHTML = '<tr><td><strong>' + esc(name) + '</strong></td>' +
        '<td class="col-record"><strong>' + w + '–' + l + (t ? '–' + t : '') + '</strong></td>' +
        '<td class="col-pf"><strong>' + pf.toFixed(1) + '</strong></td>' +
        '<td colspan="3"><span class="dim">' + rows.length + ' season' + (rows.length === 1 ? '' : 's') +
        ' · ' + g + ' games · ' +
        (g ? ((w + 0.5 * t) / g).toFixed(3) : '—') + ' win% · ' +
        (titles ? titles + ' title' + (titles === 1 ? '' : 's') : 'no titles') + '</span></td></tr>';
    }

    sel.addEventListener('change', function () { render(sel.value); });
    render(sel.value);
  })();
  </script>
</section>

<div class="rule rule-single"></div>

<!-- ================================================== RIVALRY FILE -->
<section id="rivalry">
  <div class="kicker">── Chapter V · The Rivalry File ──</div>
  <p class="section-blurb">The most-played grudges in league history, plus the tightest and the ugliest of the lot.</p>

  <div class="hof-rivalry-cards">
    {% for r in rivalries[:6] %}
    <div class="rivalry-card">
      <div class="rivalry-pair">{{ r.a }} <span class="versus-sm">v</span> {{ r.b }}</div>
      <div class="rivalry-score">{{ r.a_wins }}–{{ r.b_wins }}{% if r.ties %}–{{ r.ties }}{% endif %}</div>
      <div class="rivalry-meta">{{ r.games }} meetings · avg margin {{ "%.1f"|format(r.avg_margin) }}</div>
      <div class="rivalry-meta dim">Closest {{ r.closest }}</div>
      <div class="rivalry-meta dim">Current streak {{ r.streak }}</div>
    </div>
    {% endfor %}
  </div>

  <h3 class="hof-subhead">Head-to-Head</h3>
  <p class="hof-footnote">Pick a manager to see their record against every other manager in league history. Head-to-head counts posted
    weekly scores; the All-Time Ledger follows Sleeper's official standings, which absorb stat corrections — so a corrected
    result or two may differ between the two charts.</p>

  <div class="h2h-picker">
    <label for="h2h-select">Manager</label>
    <select id="h2h-select">
      {% for m in h2h_managers %}<option value="{{ m }}">{{ m }}</option>{% endfor %}
    </select>
    <span class="h2h-hint">Regular season, all seasons</span>
  </div>

  <div class="hof-scroll">
    <table class="rankings-table hof-table h2h-table">
      <thead>
        <tr>
          <th>Opponent</th>
          <th class="col-record">Record</th>
          <th class="col-pf">Avg Margin</th>
          <th>Closest</th>
          <th>Worst Beating</th>
          <th>Streak</th>
          <th>Last Meeting</th>
        </tr>
      </thead>
      <tbody id="h2h-body">
        <tr><td colspan="7" class="dim">Select a manager above.</td></tr>
      </tbody>
      <tfoot id="h2h-foot"></tfoot>
    </table>
  </div>
  <noscript><p class="hof-footnote">The interactive table needs JavaScript enabled.</p></noscript>

  <script type="application/json" id="h2h-data">{{ h2h_detail|tojson }}</script>
  <script>
  (function () {
    var data = JSON.parse(document.getElementById('h2h-data').textContent);
    var sel = document.getElementById('h2h-select');
    var body = document.getElementById('h2h-body');
    var foot = document.getElementById('h2h-foot');

    function esc(t) {
      return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c];
      });
    }

    function render(name) {
      var rows = data[name] || [];
      if (!rows.length) {
        body.innerHTML = '<tr><td colspan="7" class="dim">No completed meetings on record.</td></tr>';
        foot.innerHTML = '';
        return;
      }
      var w = 0, l = 0, t = 0, g = 0;
      var html = rows.map(function (r) {
        w += r.w; l += r.l; t += r.t; g += r.games;
        var lead = r.w > r.l ? 'h2h-lead' : (r.w < r.l ? 'h2h-trail' : '');
        return '<tr>' +
          '<td><strong>' + esc(r.opp) + '</strong></td>' +
          '<td class="col-record ' + lead + '">' + r.w + '–' + r.l + (r.t ? '–' + r.t : '') + '</td>' +
          '<td class="col-pf">' + Number(r.avg_margin).toFixed(1) + '</td>' +
          '<td class="dim">' + esc(r.closest) + '</td>' +
          '<td class="dim">' + esc(r.biggest) + '</td>' +
          '<td>' + esc(r.streak) + '</td>' +
          '<td class="dim">' + esc(r.last) + '</td>' +
        '</tr>';
      }).join('');
      body.innerHTML = html;
      var overall = (w + 0.5 * t) / (g || 1);
      foot.innerHTML = '<tr><td><strong>' + esc(name) + ' — all opponents</strong></td>' +
        '<td class="col-record"><strong>' + w + '–' + l + (t ? '–' + t : '') + '</strong></td>' +
        '<td class="col-pf"><strong>' + overall.toFixed(3) + ' win%</strong></td>' +
        '<td colspan="4"><span class="dim">' + g + ' games across ' + rows.length + ' opponents</span></td></tr>';
    }

    sel.addEventListener('change', function () { render(sel.value); });
    render(sel.value);
  })();
  </script>
</section>

<div class="rule rule-single"></div>

<!-- ================================================== LEDGER OF DEALS -->
<section id="deals">
  <div class="kicker">── Chapter VI · The Ledger of Deals ──</div>
  <p class="section-blurb">{{ totals.trades }} trades and {{ totals.moves }} total roster moves on record. Some were strategy. Most were panic.</p>
  <div class="hof-scroll">
    <table class="rankings-table hof-table">
      <thead>
        <tr>
          <th class="col-rank">#</th>
          <th>Manager</th>
          <th class="col-pf">Moves</th>
          <th class="col-pf">Trades</th>
          <th class="col-pf">Waivers</th>
          <th class="col-pf">Free Agents</th>
          <th class="col-pf">Moves/Season</th>
        </tr>
      </thead>
      <tbody>
        {% for m in managers|sort(attribute='moves', reverse=true) %}
        <tr>
          <td class="col-rank">{{ loop.index }}</td>
          <td><strong>{{ m.name }}</strong></td>
          <td class="col-pf">{{ m.moves }}</td>
          <td class="col-pf">{{ m.trades }}</td>
          <td class="col-pf">{{ m.waivers }}</td>
          <td class="col-pf">{{ m.fa }}</td>
          <td class="col-pf">{{ "%.1f"|format(m.moves / m.seasons) if m.seasons else '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<div class="rule rule-single"></div>

<!-- ================================================== BENCH FILE -->
<section id="bench">
  <div class="kicker">── Chapter VII · The Bench File ──</div>
  <p class="section-blurb">Points left sitting on the bench. Every lineup has one regret; this is the ledger of them. Best-ball record replays
    each week as though the optimal lineup had been started — a measure of talent wasted on hesitation.</p>
  <div class="hof-scroll">
    <table class="rankings-table hof-table">
      <thead>
        <tr>
          <th class="col-rank">#</th>
          <th>Manager</th>
          <th class="col-pf">Bench Pts</th>
          <th class="col-pf">Per Week</th>
          <th>Worst Week</th>
          <th class="col-pf">Clean Sheets</th>
          <th class="col-pf">Wins Left</th>
        </tr>
      </thead>
      <tbody>
        {% for m in managers|sort(attribute='bench_total', reverse=true) %}
        <tr>
          <td class="col-rank">{{ loop.index }}</td>
          <td><strong>{{ m.name }}</strong></td>
          <td class="col-pf">{{ "%.0f"|format(m.bench_total) }}</td>
          <td class="col-pf">{{ "%.1f"|format(m.bench_avg) }}</td>
          <td class="dim">{{ m.bench_worst }}</td>
          <td class="col-pf">{{ m.bench_clean }}</td>
          <td class="col-pf">{% if m.wins_left %}<strong>{{ m.wins_left }}</strong>{% else %}—{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="hof-footnote">Clean sheets = weeks with nothing of value left on the bench. <strong>Wins left</strong> = regular-season
    games lost that a perfect lineup would have won against the score the opponent actually posted — always zero or better, and
    slot-blind (it assumes the top scorers on the roster start, regardless of position).</p>
</section>

<div class="rule rule-single"></div>

<!-- ================================================== TRADE LEDGER -->
<section id="trades">
  <div class="kicker">── Chapter VIII · The Trade Ledger ──</div>
  <p class="section-blurb">{{ trades|length }} trades graded on what each side actually received afterwards — points scored by the
    acquired players, rest of season, in the new colours. Verdicts are unforgiving and entirely hindsight-based, as is tradition.
    Nothing is judged until three weeks have passed, and draft picks score nothing here, so a picks-for-player deal is
    reported ungraded rather than declared a wash.</p>

  <div class="hof-scroll">
    <table class="rankings-table hof-table trade-table">
      <thead>
        <tr>
          <th class="col-rank">When</th>
          <th>Winner</th>
          <th>Received</th>
          <th class="col-pf">Pts</th>
          <th>Loser</th>
          <th>Received</th>
          <th class="col-pf">Pts</th>
          <th class="col-pf">Verdict</th>
        </tr>
      </thead>
      <tbody>
        {% for t in trades %}
        <tr>
          <td class="col-rank">{{ t.season }}<span class="dim"> W{{ t.week }}</span>
            <br><span class="dim">{{ t.weeks_elapsed }}w of returns</span></td>
          <td><strong>{{ t.winner.manager }}</strong></td>
          <td class="trade-assets">
            {% for p in t.winner.players %}{{ p.name }} <span class="dim">({{ p.pos }})</span>{% if not loop.last %}, {% endif %}{% endfor %}
            {% if t.winner.picks %}<span class="dim">+ {{ t.winner.picks }} pick{% if t.winner.picks != 1 %}s{% endif %} (unscored)</span>{% endif %}
          </td>
          <td class="col-pf"><strong>{{ "%.0f"|format(t.winner.total) }}</strong></td>
          <td>{{ t.loser.manager }}</td>
          <td class="trade-assets dim">
            {% for p in t.loser.players %}{{ p.name }}{% if not loop.last %}, {% endif %}{% endfor %}
            {% if t.loser.picks %}+ {{ t.loser.picks }} pick{% if t.loser.picks != 1 %}s{% endif %} (unscored){% endif %}
          </td>
          <td class="col-pf">{{ "%.0f"|format(t.loser.total) }}</td>
          <td class="col-pf verdict">{{ "%.0f"|format(t.margin) }} <span class="dim">{{ t.level }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="hof-footnote">Rest-of-season points only, in half-PPR terms, counted from the week after the deal. A trade needs
    three weeks of returns before it earns a verdict; until then it reads "too recent to judge" and is left out of career trade
    margins. Draft picks are listed but not scored — this page has no honest way to value them — so a deal that returned only
    picks is marked ungraded instead of balanced. Two further trades are excluded: Sleeper's roster numbering on those records
    does not match the weekly rosters, so the returns cannot be verified.</p>
